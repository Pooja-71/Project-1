<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <!-- Header -->
        <h1 class="text-3xl">Hello, <%= user.name %> 👋</h1>
        <h5 class="mb-5 text-zinc-400">you can create a new post.</h5>

        <!-- Create Post Form -->
        <form action="/post" method="post">
            <textarea 
                placeholder="What's on your mind ?" 
                class="block p-3 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md w-1/3" 
                name="content"
            ></textarea>
            <input 
                class="px-3 py-2 bg-blue-500 block rounded-md mt-2 text-sm cursor-pointer" 
                type="submit" 
                value="Create New Post"
            >
        </form>

        <!-- Posts Container -->
        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your Posts.</h3>
            
            <div class="postcontainer mt-5 flex flex-col gap-3">
                <% user.posts.reverse().forEach(function(post) { %>
                    <div class="post w-1/3 p-4 rounded-md border-[2px] border-zinc-700 bg-zinc-800">
                        <h4 class="text-blue-500 mb-2">@<%= user.username %></h4>
                        <p class="text-sm tracking-tight text-zinc-300"><%= post.content %></p>
                        <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
                        <div class="btns flex gap-4 mt-1">
                            <a class="text-blue-500 text-sm" href="/like/<%= post._id %>">
                                <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                            </a>
                            <a class="text-zinc-600 text-sm" href="/edit/<%= post._id %>">edit</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

    </div>
</body>

</html>